(include_subdirs unqualified)
(library
 (name fstarcompiler)
 (public_name fstar.compiler)
 (wrapped false)
 (libraries
    batteries
    zarith
    stdint
    yojson
    ppxlib
    dynlink
    menhirLib
    pprint
    process
    sedlex
    mtime.clock
 )
 (modes native byte)
 ; Propagated to clients as jsoo_runtime in the installed META, so that
 ; anything linking fstar.compiler with js_of_ocaml picks up the C-stub
 ; replacements automatically.
 (js_of_ocaml (javascript_files jsoo/fstar_jsoo_runtime.js))
 (preprocess (pps ppx_deriving.show ppx_deriving_yojson sedlex.ppx))
)

(menhir
 (modules FStarC_Parser_Parse))
(menhir
 (modules FStarC_Parser_WarnError))

(rule
  (target FStarC_Version.ml)
  (deps (:script make_fstar_version.sh)
        (:version ../../version.txt))
  (action
    (progn
      (copy %{version} version.txt)
      (with-stdout-to
        FStarC_Version.ml
        (run bash %{script})))))
